# Opcional: sobreescribe la URL canónica (por defecto https://www.manantialdemoda.com).
# La usan metadataBase, sitemap.xml, robots.txt y los schemas JSON-LD.
# NEXT_PUBLIC_SITE_URL=https://www.manantialdemoda.com

# MCP de Odoo (n8n) que expone verificar_inventario.
# El path incluye el token de la webhook: pedirlo al administrador de n8n.
ODOO_MCP_URL=https://<host>/mcp/<token>

# Token que el cron de Vercel manda como Bearer para revalidar el inventario.
CRON_SECRET=<cadena-larga-aleatoria>
